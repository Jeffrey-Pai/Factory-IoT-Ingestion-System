    {
      "id": 9,
      "type": "stat",
      "title": "預估清空時間",
      "datasource": {
        "type": "prometheus",
        "uid": "factory-iot-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 6
      },
      "pluginVersion": "10.4.2",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 86400,
                "to": 1000000000000.0,
                "result": {
                  "text": "⚠ 追不上,持續積壓",
                  "color": "#d03b3b",
                  "index": 0
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 300
              },
              {
                "color": "#d03b3b",
                "value": 1800
              }
            ]
          },
          "unit": "s",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "factory-iot-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rabbitmq_queue_messages_ready{queue=\"$queue\"}) / clamp_min((sum(rate(telemetry_consumed_total[5m])) or vector(0)) - (sum(rate(rabbitmq_queue_messages_published_total{queue=\"$queue\"}[5m])) or vector(0)), 0.0001)",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "description": "用目前的淨消化速度,把現有積壓清光要多久。消化速率低於發布速率時永遠清不完,會直接顯示「追不上」。"
    },
