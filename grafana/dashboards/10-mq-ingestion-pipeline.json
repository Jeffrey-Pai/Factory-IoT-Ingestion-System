        "type": "prometheus",
        "uid": "factory-iot-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "pluginVersion": "10.4.2",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 1000
              },
              {
                "color": "#ec835a",
                "value": 5000
              },
              {
                "color": "#d03b3b",
                "value": 10000
              }
            ]
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "factory-iot-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rabbitmq_queue_messages_ready{queue=\"$queue\"})",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "description": "等著被消化、還沒送出去的訊息數。這是「MQ 有沒有在累積」最直接的答案。健康時應該接近 0,持續往上就是消化端跟不上。門檻對應告警 fiot-backlog-warning / -critical。"
    },
